# Optional machine-local Simics paths for intel-fpga-main / intel-fpga-ext_main.
#
#   cp local-env.sh.example local-env-main.sh
#   # edit SIMICS_BASE, then:
#   source ./set_simics_env_main.sh
#
# Do not commit host-specific paths.

# Required when auto-detect fails (set to the directory that contains bin/simics):
# export SIMICS_BASE="$HOME/altera_pro/intel-fpga-ext_main/simics/simics-7.XX.Y"
# export SIMICS_BASE="$HOME/intelFPGA_pro/intel-fpga-main.6892/simics/simics-7.XX.Y"

# Parent of platforms/ (usually dirname of SIMICS_BASE = .../simics):
# export SIMICS_FPGA_ROOT="$HOME/altera_pro/intel-fpga-ext_main/simics"

# Optional SDM HMOD firmware override:
# export SDM_HMOD_FW="$SIMICS_FPGA_ROOT/platforms/agilex72-universal/binaries/sdm_hmod_fw/sdm_hmod_fw.hex"
