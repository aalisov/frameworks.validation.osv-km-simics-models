# KM CI agent defaults — source from other km-ci scripts (override via env).
# shellcheck shell=bash

: "${KM_HPS:=${HOME}/km-hps}"
: "${SHARE_ROOT:=http://alisubun1.sj.altera.com/osbv-yo/KM}"
: "${KM_CI_FLAVOR:=osbv}"                 # v1: osbv (osbv_sdmmc). emul plumbing only.
: "${KM_CI_POLL_INTERVAL_HINT:=15m}"

: "${KM_CI_VAR:=${KM_HPS}/var}"
: "${KM_CI_RESULTS:=${KM_HPS}/test-results}"
: "${KM_CI_LOCK:=${KM_CI_VAR}/agent.lock}"
: "${KM_CI_LONG_PIDS:=${KM_CI_VAR}/long-sims.pids}"
: "${KM_CI_LAST_MANIFEST:=${KM_CI_VAR}/last-osbv-manifest.txt}"
: "${KM_CI_AGENT_LOG:=${KM_CI_VAR}/agent.log}"

# Gate / long-sim UART telnet (instances 0..2 for A/B/C)
: "${KM_CI_GATE_TELNET:=9123}"
: "${KM_CI_LONG_A_TELNET:=9123}"
: "${KM_CI_LONG_B_TELNET:=9124}"
: "${KM_CI_LONG_C_TELNET:=9125}"
: "${KM_CI_LONG_A_INSTANCE:=0}"
: "${KM_CI_LONG_B_INSTANCE:=1}"
: "${KM_CI_LONG_C_INSTANCE:=2}"

# U-Boot gate scripts on SDMMC FAT (mkimage .scr under km-tests/)
# Image has fdt.scr (not dt.scr), i2c/i3c/usb/eth; spi.scr also present.
: "${KM_CI_UBOOT_SCR_MODE:=fatload}"   # fatload | paste
: "${KM_CI_UBOOT_FAT_DIR:=km-tests}"
# Literal U-Boot env refs — assign with single quotes (avoid bash ${} nesting).
[[ -n "${KM_CI_UBOOT_MMC_SPEC:-}" ]] || KM_CI_UBOOT_MMC_SPEC='${mmcdev}:1'
[[ -n "${KM_CI_UBOOT_SCRIPTADDR:-}" ]] || KM_CI_UBOOT_SCRIPTADDR='${scriptaddr}'
: "${KM_CI_UBOOT_SCRS:=fdt.scr,i2c.scr,i3c.scr,usb.scr,eth.scr}"
# All .scr results are report-only. Gate PASS = U-Boot prompt reached (then long sims).
# Use "*" or a comma list; default "*" = every script in KM_CI_UBOOT_SCRS.
: "${KM_CI_UBOOT_NONBLOCKING_SCRS:=*}"
# 1 = Linux smoke is report-only too (default); 0 = Linux FAIL fails the gate
: "${KM_CI_LINUX_NONBLOCKING:=1}"

# Timeouts (seconds)
: "${KM_CI_UBOOT_BOOT_TIMEOUT:=300}"
# Per-script budget (i2c suite + eth ping need headroom)
: "${KM_CI_SCR_CMD_TIMEOUT:=300}"
: "${KM_CI_LINUX_BOOT_TIMEOUT:=600}"
: "${KM_CI_LINUX_CMD_TIMEOUT:=120}"
: "${KM_CI_STOP_WAIT:=15}"

: "${KM_CI_UBOOT_PROMPT:=SOCFPGA_KM # }"
: "${KM_CI_LINUX_LOGIN:=login:}"
: "${KM_CI_LINUX_USER:=root}"
# Must not be bare "(#|$)" — that rematches the previous prompt still in the buffer.
: "${KM_CI_LINUX_SHELL_RE:=root@\\S+:\\S+[#\$] }"
: "${KM_CI_GUEST_GW:=10.10.0.1}"
: "${KM_CI_GUEST_ETH_IP:=10.10.0.100}"
# Guest command after Linux login on long sims B/C (UART; keep short)
# Full path on osbv rootfs (km-pve-hps-content / pve-hps package).
: "${KM_CI_GUEST_ETH_SETUP:=/usr/local/pve-hps/bin/setup-simics-eth.sh}"
# 1 = after launching Linux long sims, wait for login and run KM_CI_GUEST_ETH_SETUP
: "${KM_CI_LONG_SETUP_ETH:=1}"

# Long-sim catalog: scripts/km-ci/long-sims.list (id instance telnet guest_eth script args...)
# KM_CI_LONG_SCRIPTS = comma list of IDs to launch (empty = all rows in the list file).
: "${KM_CI_LONG_LIST:=${KM_HPS}/scripts/km-ci/long-sims.list}"
: "${KM_CI_LONG_SCRIPTS:=}"   # e.g. A,B,C — empty means all entries in KM_CI_LONG_LIST
# Seconds to wait before probing telnet "up" after launch
: "${KM_CI_LONG_UP_WAIT:=8}"

# 1 = skip launching long sims after gate (PASS/FAIL still publish runs)
: "${KM_CI_SKIP_LONG:=0}"
# 1 = force stage+gate even if MANIFEST unchanged
: "${KM_CI_FORCE:=0}"

# Web status/runs publish — prefer one GitHub monorepo (no alisubun1 SSH on agents).
# Repo: https://github.com/altera-sandbox/frameworks.validation.osv-auto.km-simics-web
: "${KM_SIMICS_WEB_GIT:=https://github.com/altera-sandbox/frameworks.validation.osv-auto.km-simics-web.git}"
# Public URLs (GitHub Pages after enabling: Settings → Pages → Deploy from branch main / root)
: "${KM_SIMICS_STATUS_URL:=https://altera-sandbox.github.io/frameworks.validation.osv-auto.km-simics-web/simics-status/}"
: "${KM_SIMICS_RUNS_URL:=https://altera-sandbox.github.io/frameworks.validation.osv-auto.km-simics-web/simics-runs/}"
# Optional: override with dedicated remotes (legacy alisubun1 bare repos) — leave empty to use WEB_GIT
: "${KM_SIMICS_STATUS_GIT:=}"
: "${KM_SIMICS_RUNS_GIT:=}"
# Optional direct rsync/scp/cp targets (in addition to git):
: "${KM_SIMICS_STATUS_DEST:=}"
: "${KM_SIMICS_RUNS_DEST:=}"
# 1 = auto --publish after gate / long-sims when WEB_GIT / *_GIT / *_DEST is set
: "${KM_CI_PUBLISH_WEB:=1}"
# Optional HTTPS push token (else rely on git credential helper / deploy key)
: "${KM_CI_GITHUB_TOKEN:=}"


# Email via mailx / s-nail → Altera SMTP relay
: "${KM_CI_MAIL_ENABLE:=1}"
: "${KM_CI_MAIL_MTA:=smtp://smtp.altera.com:587}"
: "${KM_CI_MAIL_TO:=andrey.lisov@altera.com}"
: "${KM_CI_MAIL_FROM:=}"
: "${KM_CI_MAIL_SUBJECT_PREFIX:=[KM-CI $(hostname -s 2>/dev/null || hostname)]}"
: "${KM_CI_MAILX:=s-nail}"
# Optional extra hook after mail: KM_CI_NOTIFY_CMD='...'

mkdir -p "$KM_CI_VAR" "$KM_CI_RESULTS"
