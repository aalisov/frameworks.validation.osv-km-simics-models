# KM CI agent defaults — source from other km-ci scripts (override via env).
# shellcheck shell=bash

: "${KM_HPS:=${HOME}/km-hps}"
: "${SHARE_ROOT:=http://alisubun1.sj.altera.com/osbv-yo/KM}"
: "${KM_CI_FLAVOR:=osbv}"                 # v1: osbv (osbv_sdmmc). emul plumbing only.
: "${KM_CI_POLL_INTERVAL_HINT:=15m}"

: "${KM_CI_VAR:=${KM_HPS}/var}"
: "${KM_CI_RESULTS:=${KM_HPS}/test-results}"
: "${KM_CI_LOCK:=${KM_CI_VAR}/agent.lock}"
: "${KM_CI_LONG_PIDS:=${KM_CI_VAR}/long-sims.pids}"
: "${KM_CI_LAST_MANIFEST:=${KM_CI_VAR}/last-osbv-manifest.txt}"
: "${KM_CI_AGENT_LOG:=${KM_CI_VAR}/agent.log}"

# Gate / long-sim UART telnet (instances 0..2 for A/B/C)
: "${KM_CI_GATE_TELNET:=9123}"
: "${KM_CI_LONG_A_TELNET:=9123}"
: "${KM_CI_LONG_B_TELNET:=9124}"
: "${KM_CI_LONG_C_TELNET:=9125}"
: "${KM_CI_LONG_A_INSTANCE:=0}"
: "${KM_CI_LONG_B_INSTANCE:=1}"
: "${KM_CI_LONG_C_INSTANCE:=2}"

# U-Boot gate scripts on SDMMC FAT (mkimage .scr under km-tests/)
# Image has fdt.scr (not dt.scr), i2c/i3c/usb/eth; spi.scr also present.
: "${KM_CI_UBOOT_SCR_MODE:=fatload}"   # fatload | paste
: "${KM_CI_UBOOT_FAT_DIR:=km-tests}"
# Literal U-Boot env refs — assign with single quotes (avoid bash ${} nesting).
[[ -n "${KM_CI_UBOOT_MMC_SPEC:-}" ]] || KM_CI_UBOOT_MMC_SPEC='${mmcdev}:1'
[[ -n "${KM_CI_UBOOT_SCRIPTADDR:-}" ]] || KM_CI_UBOOT_SCRIPTADDR='${scriptaddr}'
: "${KM_CI_UBOOT_SCRS:=fdt.scr,i2c.scr,i3c.scr,usb.scr,eth.scr}"

# Timeouts (seconds)
: "${KM_CI_UBOOT_BOOT_TIMEOUT:=300}"
# Per-script budget (i2c suite + eth ping need headroom)
: "${KM_CI_SCR_CMD_TIMEOUT:=300}"
: "${KM_CI_LINUX_BOOT_TIMEOUT:=600}"
: "${KM_CI_LINUX_CMD_TIMEOUT:=120}"
: "${KM_CI_STOP_WAIT:=15}"

: "${KM_CI_UBOOT_PROMPT:=SOCFPGA_KM # }"
: "${KM_CI_LINUX_LOGIN:=login:}"
: "${KM_CI_LINUX_USER:=root}"
# Must not be bare "(#|$)" — that rematches the previous prompt still in the buffer.
: "${KM_CI_LINUX_SHELL_RE:=root@\\S+:\\S+[#\$] }"
: "${KM_CI_GUEST_GW:=10.10.0.1}"
: "${KM_CI_GUEST_ETH_IP:=10.10.0.100}"
# Guest command after Linux login on long sims B/C (UART; keep short)
: "${KM_CI_GUEST_ETH_SETUP:=./setup-simics-eth0.sh}"
# 1 = after launching B/C, wait for login and run KM_CI_GUEST_ETH_SETUP
: "${KM_CI_LONG_SETUP_ETH:=1}"

# 1 = skip launching long sims after gate pass
: "${KM_CI_SKIP_LONG:=0}"
# 1 = force stage+gate even if MANIFEST unchanged
: "${KM_CI_FORCE:=0}"

# Apache/NFS publish (alisubun1 webdata). Leave DEST empty to skip remote push.
# Folders under SHARE_ROOT:
#   simics-status  → latest gate smoke SUMMARY
#   simics-runs    → live Simics instance table
: "${KM_SIMICS_STATUS_URL:=${SHARE_ROOT}/simics-status/}"
: "${KM_SIMICS_RUNS_URL:=${SHARE_ROOT}/simics-runs/}"
# Examples (pick NFS mount or scp target that Apache serves):
#   KM_SIMICS_STATUS_DEST=/DISK1/nfs/webdata/osbv-yo/KM/simics-status
#   KM_SIMICS_RUNS_DEST=/DISK1/nfs/webdata/osbv-yo/KM/simics-runs
#   KM_SIMICS_STATUS_DEST=alisov@alisubun1:/DISK1/nfs/webdata/osbv-yo/KM/simics-status
#   KM_SIMICS_RUNS_DEST=alisov@alisubun1:/DISK1/nfs/webdata/osbv-yo/KM/simics-runs
: "${KM_SIMICS_STATUS_DEST:=}"
: "${KM_SIMICS_RUNS_DEST:=}"
# 1 = auto --publish after gate / long-sims when DEST is set
: "${KM_CI_PUBLISH_WEB:=1}"

mkdir -p "$KM_CI_VAR" "$KM_CI_RESULTS"
